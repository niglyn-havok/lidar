# Normalize text while leaving binary/LFS content untouched.
* text=auto

# Preserve original downloaded bytes used by source SHA-256 checks.
generated-data/sources/osm-hydrology.json -text
generated-data/imagery/originals/315500_234000/315500_234000.tfw -text
generated-data/imagery/originals/315500_234500/315500_234500.tfw -text
generated-data/imagery/originals/316000_234000/316000_234000.tfw -text
generated-data/imagery/originals/316000_234500/316000_234500.tfw -text

# These generated JSON hashes bind their original, deliberately different endings.
DublinFlight/Content/Data/facade-provenance.json text eol=lf
DublinFlight/Content/Data/dublin-ortho-georeference.json text eol=crlf
generated-data/imagery/partial-import-contract.json text eol=crlf

# Unreal authored assets
*.uasset filter=lfs diff=lfs merge=lfs -text
*.umap filter=lfs diff=lfs merge=lfs -text

# Source datasets and scientific arrays
*.laz filter=lfs diff=lfs merge=lfs -text
*.las filter=lfs diff=lfs merge=lfs -text
*.tif filter=lfs diff=lfs merge=lfs -text
*.tiff filter=lfs diff=lfs merge=lfs -text
*.npz filter=lfs diff=lfs merge=lfs -text
*.zip filter=lfs diff=lfs merge=lfs -text

# Images, video, and editable artwork
*.png filter=lfs diff=lfs merge=lfs -text
*.jpg filter=lfs diff=lfs merge=lfs -text
*.jpeg filter=lfs diff=lfs merge=lfs -text
*.gif filter=lfs diff=lfs merge=lfs -text
*.mp4 filter=lfs diff=lfs merge=lfs -text
*.blend filter=lfs diff=lfs merge=lfs -text

# Large generated contracts and retained automation captures
DublinFlight/Content/Data/dublin-city.json filter=lfs diff=lfs merge=lfs -text
generated-data/city-provenance.json filter=lfs diff=lfs merge=lfs -text
generated-data/facade-evidence.json filter=lfs diff=lfs merge=lfs -text
generated-data/sources/osm-buildings.json filter=lfs diff=lfs merge=lfs -text
DublinFlight/Saved/automation/checkpoint-*.json filter=lfs diff=lfs merge=lfs -text
DublinFlight/Saved/automation/gameplay-*-capture.json filter=lfs diff=lfs merge=lfs -text
DublinFlight/Saved/automation/sample-*.json filter=lfs diff=lfs merge=lfs -text
